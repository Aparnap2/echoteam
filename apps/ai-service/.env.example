# EchoTeam AI Service - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=echoteam-ai-service
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# Qdrant Cloud Configuration (Required for production)
# =============================================================================
# Get these from https://cloud.qdrant.io
QDRANT_URL=https://xxxxx-xxxxx.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# =============================================================================
# Langfuse Observability (Optional - for tracing)
# =============================================================================
# Get these from https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# OpenAI (Optional - for cloud LLM fallback)
# =============================================================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-3.5-turbo

# =============================================================================
# Ollama (For local embedding generation)
# =============================================================================
# Local development only - not used in production
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EMBEDDING=nomic-embed-text:v1.5
OLLAMA_MODEL_CODING=qwen2.5-coder:3b
OLLAMA_MODEL_REASONING=granite3.1-moe:3b

# =============================================================================
# HITL Configuration
# =============================================================================
CONFIDENCE_THRESHOLD=0.85
AUTO_ACTIONS=summarize,categorize,extract
APPROVAL_ACTIONS=draft,send,create_event
