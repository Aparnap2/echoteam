# EchoTeam AI Service Environment Variables

# Application
APP_NAME=echoteam-ai-service
APP_VERSION=0.1.0
DEBUG=true

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CODING=qwen2.5-coder:3b
OLLAMA_MODEL_REASONING=granite3.1-moe:3b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text:v1.5

# FalkorDB Configuration
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_DATABASE=echoteam

# Graphiti Configuration
GRAPHITI_HOST=http://localhost:8080

# HITL Configuration
CONFIDENCE_THRESHOLD=0.85
