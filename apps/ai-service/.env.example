# EchoTeam AI Service Environment Variables

# Application
APP_NAME=echoteam-ai-service
APP_VERSION=0.1.0
DEBUG=true

# Cognee Memory Configuration (LLM for knowledge graph construction)
# Use Ollama for local development, swap to OpenAI/Groq for production
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:3b
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama  # Dummy key required by LiteLLM for local Ollama
# LLM_API_VERSION=
# LLM_MAX_TOKENS=16384

# Ollama Configuration (for other AI tasks - embeddings, reasoning)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CODING=qwen2.5-coder:3b
OLLAMA_MODEL_REASONING=granite4:1b-h
OLLAMA_MODEL_EMBEDDING=nomic-embed-text:v1.5

# LanceDB Configuration (embedded vector DB, bundled with Cognee)
COGNEE_DATA_ROOT=./data/cognee
COGNEE_SYSTEM_ROOT=./data/cognee_system
COGNEE_CHUNK_SIZE=512
COGNEE_CHUNK_OVERLAP=50

# FalkorDB Configuration (optional - for hybrid vector+graph when adapter is ready)
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_DATABASE=echoteam

# Graphiti Configuration (optional - legacy memory system)
GRAPHITI_HOST=http://localhost:8080

# HITL Configuration
CONFIDENCE_THRESHOLD=0.85
