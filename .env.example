# EchoTeam Environment Variables

# Database
DATABASE_URL=postgresql://echoteam:echoteam_dev@localhost:5432/echoteam

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CODING=qwen2.5-coder:3b
OLLAMA_MODEL_REASONING=granite3.1-moe:3b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text:v1.5

# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_DATABASE=echoteam

# Graphiti
GRAPHITI_HOST=http://localhost:8080

# AI Service
AI_SERVICE_URL=http://localhost:8000

# API Server
PORT=3001
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3001

# HITL Settings
CONFIDENCE_THRESHOLD=0.85
